# ==============================================================================
# Production .env for a single-VM deployment (Docker Compose + Caddy)
# ==============================================================================
# Copy this file to `.env` next to docker-compose.yml, fill in the values, then
# run `bash deploy.sh`. The file is read by both Docker Compose (for API_DOMAIN,
# PLUTO_IMAGE, ...) and the API container (everything else).
#
# Values may be quoted. `deploy.sh` refuses to start while the required secrets
# are empty or still set to the development defaults.
#
# This is one environment. Staging and production must each have their own VM
# and their own DATABASE_URL and secrets -- see `docs/ENVIRONMENTS.md`.

# ==============================================================================
# Reverse proxy / deployment (consumed by docker-compose.yml)
# ==============================================================================
# Hostname that Caddy obtains a certificate for, e.g. api.pluto.example.
# Point an A/AAAA record at the VM first and allow inbound 80 + 443 (TCP, and
# 443/UDP for HTTP/3). Use `:80` ONLY for a throwaway IP-only HTTP deployment.
API_DOMAIN=api.example.com
# Let's Encrypt/ZeroSSL contact address (expiry notices only).
ACME_EMAIL=you@example.com

# Optional prebuilt image. Leave empty to build on the VM (needs ~2 GB RAM --
# on a 1 GB e2-micro, publish from CI and use `bash deploy.sh pull` instead).
# Example: ghcr.io/your-org/pluto-server:latest
PLUTO_IMAGE=

# Container memory cap and Node heap cap. 512m/320MB suits the API alone on a
# 1 GB VM; raise both together on a bigger machine.
API_MEMORY_LIMIT=512m
NODE_OPTIONS=--max-old-space-size=320

# ==============================================================================
# Server
# ==============================================================================
NODE_ENV=production
PORT=3000
API_PREFIX=v1

# Browser origins allowed to call the API. Comma-separated, explicit, https in
# production -- a wildcard is refused at boot. Native mobile clients do not
# send an Origin and are unaffected.
CORS_ORIGIN=https://pluto.example.com

# How many proxies in front of the API to trust for req.ip / X-Forwarded-For:
#   true  -> exactly one hop (Caddy). This is the normal VM setup.
#   2     -> Caddy plus a CDN such as Cloudflare proxying the request.
#   false -> the API is exposed directly (not recommended).
TRUST_PROXY=true

# ==============================================================================
# Database (PostgreSQL via Prisma)
# ==============================================================================
# Use a managed branch (Neon etc.), not a Postgres running on this VM.
# - Neon pooler host, drop `channel_binding=require` if present (Prisma cannot
#   use it).
# - connection_limit keeps the client pool small on a 1 GB box.
# - If `prisma migrate deploy` fails with a prepared-statement/pooler error, use
#   the direct (non-`-pooler`) host for this URL; see docs/ENVIRONMENTS.md.
DATABASE_URL='postgresql://user:password@ep-example-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require&connection_limit=5&pool_timeout=10'

# ==============================================================================
# Authentication
# ==============================================================================
# The Google *Web* client ID the mobile app requests its ID token with (and any
# additional accepted audiences), comma-separated. Required in production.
GOOGLE_ALLOWED_CLIENT_IDS=

# 32+ random characters. NEVER reuse the development value.
# Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Comma-separated addresses promoted to ADMIN on sign-in.
ADMIN_EMAILS=

# The mock sign-in route is unusable in production; leaving this false is
# required (the server refuses to boot otherwise).
ENABLE_DEV_AUTH=false

# ==============================================================================
# Rate limiting
# ==============================================================================
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# ==============================================================================
# Exchange rates
# ==============================================================================
EXCHANGE_RATE_PROVIDER=frankfurter
EXCHANGE_RATE_API_KEY=
EXCHANGE_RATE_BASE_URL=https://api.frankfurter.dev/v2
EXCHANGE_RATE_BASE_CURRENCY=USD
EXCHANGE_RATE_CANONICAL_BASE=USD
# Optional: pin a narrower reporting universe than the full currency registry.
# SUPPORTED_CURRENCIES=USD,EUR,GBP,JPY
# Daily sync runs in-process; this VM is always on, so no external trigger is
# needed. Set RATES_SYNC_TOKEN only if you also want POST /v1/rates/sync
# (the GitHub workflow) to be able to force a sync.
EXCHANGE_RATE_SCHEDULE=0 4 * * *
EXCHANGE_RATE_HISTORICAL_LOOKBACK_DAYS=10
RATES_SYNC_TOKEN=

# ==============================================================================
# S3-compatible object storage (cloud backups)
# ==============================================================================
# Off by default: every /v1/backups/* route returns 503 and the server boots
# without a bucket. Enable only after creating the bucket (the app never does).
OBJECT_STORAGE_ENABLED=false
OBJECT_STORAGE_ENDPOINT=https://s3.filebase.io
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_BUCKET=pluto-backups
OBJECT_STORAGE_ACCESS_KEY_ID=unconfigured
OBJECT_STORAGE_SECRET_ACCESS_KEY=unconfigured
OBJECT_STORAGE_FORCE_PATH_STYLE=true

# ==============================================================================
# Backup quotas & lifecycle
# ==============================================================================
BACKUP_MAX_SIZE_BYTES=52428800
BACKUP_RETENTION_COUNT=5
BACKUP_UPLOAD_URL_TTL=900
BACKUP_DOWNLOAD_URL_TTL=900
BACKUP_PENDING_EXPIRY_HOURS=24
