# ==============================================================================
# Environments
# ==============================================================================
# This file is the *development* template. Production and staging are configured
# through the platform (Render) -- see `apps/server/render.yaml` and the
# repository-level `docs/ENVIRONMENTS.md`.
#
# Short version:
#   * local dev   -> NODE_ENV=development, a Neon `dev` branch (or local Docker)
#   * staging     -> NODE_ENV=production,  a Neon `staging` branch, its own secrets
#   * production  -> NODE_ENV=production,  the Neon `main` branch, its own secrets
# Staging and production must never share a DATABASE_URL or JWT_ACCESS_SECRET.
# Staging runs with NODE_ENV=production so it enforces the same guards (it just
# talks to different data).

# ==============================================================================
# Environment & Server
# ==============================================================================
NODE_ENV=development
PORT=3000
API_PREFIX=v1
# Comma-separated list of allowed browser origins. In production this must name
# explicit origins -- a wildcard ("*") is rejected at boot.
CORS_ORIGIN=http://localhost:3001,http://localhost:3000
# Set to false only when the app is NOT behind a trusted reverse proxy; it
# controls whether X-Forwarded-* headers are honoured for req.ip.
TRUST_PROXY=true


# ==============================================================================
# Database (PostgreSQL / Prisma)
# ==============================================================================
# Local Docker (docker compose up -d) or a Neon `dev` branch. The Neon *pooled*
# endpoint is fine for the app; for `prisma migrate dev` prefer the direct
# (non-pooler) host, or append `?pgbouncer=true`.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pluto_db?schema=public

# ==============================================================================
# Authentication & Security
# ==============================================================================
# Comma-separated list of Google OAuth 2.0 Web / Android Client IDs
GOOGLE_ALLOWED_CLIENT_IDS=
# Comma-separated e-mail addresses promoted to ADMIN on sign-in (admin API access)
ADMIN_EMAILS=admin@example.com
JWT_ACCESS_SECRET=development_jwt_access_secret_min_32_characters_long_12345
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
# Dev-only mock sign-in (POST /v1/auth/dev-login). NEVER enable in production.
# The server refuses to boot with this set when NODE_ENV=production.
ENABLE_DEV_AUTH=false

# ==============================================================================
# Rate Limiting (Throttler)
# ==============================================================================
THROTTLE_TTL=60
THROTTLE_LIMIT=100
# Auth endpoints carry their own stricter per-route limits (see AuthController).

# ==============================================================================
# Exchange Rate Synchronization
# ==============================================================================
# Provider options: frankfurter (default; free ECB reference rates via Frankfurter),
# mock (deterministic offline rates for dev/demo/tests).
# exchangerate_host is NOT implemented and will refuse to boot if selected.
EXCHANGE_RATE_PROVIDER=frankfurter
EXCHANGE_RATE_API_KEY=
EXCHANGE_RATE_BASE_URL=https://api.frankfurter.dev/v1
EXCHANGE_RATE_BASE_CURRENCY=USD
SUPPORTED_CURRENCIES=AUD,BRL,CAD,CHF,CNY,CZK,DKK,EUR,GBP,HKD,HUF,IDR,ILS,INR,ISK,JPY,KRW,MXN,MYR,NOK,NZD,PHP,PLN,RON,SEK,SGD,THB,TRY,USD,ZAR
# Cron schedule in UTC (Default: 04:00 AM UTC daily)
EXCHANGE_RATE_SCHEDULE=0 4 * * *
# Maximum snapshot age (days) before a transaction-date rate is relabeled 'estimate'
EXCHANGE_RATE_HISTORICAL_LOOKBACK_DAYS=10

# ==============================================================================
# S3-Compatible Object Storage (AWS S3, MinIO, LocalStack, Cloudflare R2)
# ==============================================================================
# Set to false to run without object storage: the server boots normally and the
# /v1/backups/* endpoints return 503 instead of surfacing storage errors.
# No-card free alternative for deployments: Filebase (https://s3.filebase.io,
# region "auto", free 5 GB tier). Create the bucket first -- the app never does.
OBJECT_STORAGE_ENABLED=true
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=pluto-backups
OBJECT_STORAGE_ACCESS_KEY_ID=minioadmin
OBJECT_STORAGE_SECRET_ACCESS_KEY=minioadmin
OBJECT_STORAGE_FORCE_PATH_STYLE=true

# ==============================================================================
# Backup Quotas & Lifecycle
# ==============================================================================
# Maximum backup file size (50 MB in bytes)
BACKUP_MAX_SIZE_BYTES=52428800
# Maximum completed snapshots retained per user (older snapshots automatically pruned)
BACKUP_RETENTION_COUNT=5
# Presigned upload URL TTL in seconds (15 minutes)
BACKUP_UPLOAD_URL_TTL=900
# Presigned download URL TTL in seconds (15 minutes)
BACKUP_DOWNLOAD_URL_TTL=900
# Abandoned pending upload expiration in hours
BACKUP_PENDING_EXPIRY_HOURS=24
