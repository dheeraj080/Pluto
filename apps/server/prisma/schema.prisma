generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BackupStatus {
  PENDING
  COMPLETED
  FAILED
  DELETED
}

enum UserRole {
  USER
  ADMIN
}

enum BudgetPeriod {
  MONTHLY
  YEARLY
}

enum RecurrenceFrequency {
  WEEKLY
  MONTHLY
  YEARLY
}

enum RecurringRuleStatus {
  ACTIVE
  PAUSED
  ENDED
}

enum OccurrenceStatus {
  PENDING
  CONFIRMED
  SKIPPED
}

model User {
  id           String           @id @default(uuid())
  email        String           @unique
  googleId     String           @unique
  name         String?
  avatarUrl    String?
  role         UserRole         @default(USER)
  baseCurrency String?          @db.VarChar(3)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  backups            Backup[]
  refreshSessions    RefreshSession[]
  expenseCategories  ExpenseCategory[]
  expenses           Expense[]
  budgets            Budget[]
  recurringExpenses  RecurringExpense[]

  @@map("users")
}

model RefreshSession {
  id           String    @id @default(uuid())
  userId       String
  tokenHash    String    @unique
  userAgent    String?
  ipAddress    String?
  isRevoked    Boolean   @default(false)
  expiresAt    DateTime
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
  @@map("refresh_sessions")
}

model RateSnapshot {
  id           String         @id @default(uuid())
  version      Int            @unique @default(autoincrement())
  baseCurrency String         @default("USD")
  effectiveDate DateTime       @db.Date
  fetchedAt    DateTime       @default(now())
  provider     String
  etag         String         @unique
  isPublished  Boolean        @default(false)

  rates        ExchangeRate[]

  @@index([isPublished, fetchedAt])
  @@index([baseCurrency, isPublished])
  @@index([baseCurrency, isPublished, effectiveDate])
  @@map("rate_snapshots")
}

model ExchangeRate {
  id            String       @id @default(uuid())
  snapshotId    String
  quoteCurrency String
  rate          Decimal      @db.Decimal(18, 6)

  snapshot      RateSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@unique([snapshotId, quoteCurrency])
  @@index([quoteCurrency])
  @@map("exchange_rates")
}

model Backup {
  id             String       @id @default(uuid())
  userId         String
  sequenceNumber Int
  schemaVersion  String
  appVersion     String
  storageKey     String       @unique
  checksumSha256 String
  fileSizeBytes  BigInt
  status         BackupStatus @default(PENDING)
  expiresAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, sequenceNumber])
  @@index([userId, status])
  @@index([userId, completedAt])
  @@index([status, expiresAt])
  @@map("backups")
}

model SystemLock {
  lockName    String   @id
  lockedUntil DateTime
  lockedBy    String
  updatedAt   DateTime @updatedAt

  @@map("system_locks")
}

model ExpenseCategory {
  id        String   @id @default(uuid())
  userId    String
  name      String
  color     String   @default("#34d399")
  icon      String?
  isDefault Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenses          Expense[]
  budgets           Budget[]
  recurringExpenses RecurringExpense[]

  @@unique([userId, name])
  @@index([userId, sortOrder])
  @@map("expense_categories")
}

model Expense {
  id                 String   @id @default(uuid())
  userId             String
  categoryId         String
  amount             Decimal  @db.Decimal(18, 2)
  currency           String   @db.VarChar(3)
  description        String?
  incurredOn         DateTime @db.Date
  paymentMethod      String?
  recurringExpenseId String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user                User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  category            ExpenseCategory             @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  recurringExpense    RecurringExpense?           @relation(fields: [recurringExpenseId], references: [id], onDelete: SetNull)
  recurringOccurrence RecurringExpenseOccurrence?

  @@index([userId, incurredOn])
  @@index([userId, categoryId])
  @@index([recurringExpenseId])
  @@map("expenses")
}

model Budget {
  id         String       @id @default(uuid())
  userId     String
  categoryId String?
  amount     Decimal      @db.Decimal(18, 2)
  currency   String       @db.VarChar(3)
  period     BudgetPeriod @default(MONTHLY)
  startDate  DateTime     @db.Date
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  category   ExpenseCategory?  @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId, period])
  @@index([userId, period])
  @@map("budgets")
}

model BudgetOverallUnique {
  userId String
  period BudgetPeriod
  @@unique([userId, period], name: "budgets_overall_userId_period_key")
  @@map("budgets_overall_unique")
}

model RecurringExpense {
  id              String              @id @default(uuid())
  userId          String
  categoryId      String
  amount          Decimal             @db.Decimal(18, 2)
  currency        String              @db.VarChar(3)
  description     String?
  paymentMethod   String?
  frequency       RecurrenceFrequency
  interval        Int                 @default(1)
  startDate       DateTime            @db.Date
  endDate         DateTime?           @db.Date
  status          RecurringRuleStatus @default(ACTIVE)
  lastGeneratedOn DateTime?           @db.Date
  pausedAt        DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  user        User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    ExpenseCategory             @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  occurrences RecurringExpenseOccurrence[]
  expenses    Expense[]

  @@index([userId, status])
  @@map("recurring_expenses")
}

model RecurringExpenseOccurrence {
  id                 String           @id @default(uuid())
  recurringExpenseId String
  dueOn              DateTime         @db.Date
  status             OccurrenceStatus @default(PENDING)
  amount             Decimal          @db.Decimal(18, 2)
  currency           String           @db.VarChar(3)
  categoryId         String
  description        String?
  paymentMethod      String?
  expenseId          String?          @unique
  confirmedAt        DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  recurringExpense RecurringExpense @relation(fields: [recurringExpenseId], references: [id], onDelete: Cascade)
  expense          Expense?         @relation(fields: [expenseId], references: [id], onDelete: SetNull)

  @@unique([recurringExpenseId, dueOn])
  @@index([status, dueOn])
  @@map("recurring_expense_occurrences")
}
