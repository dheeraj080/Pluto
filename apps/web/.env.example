# Base URL of the pluto-server API (must include the version prefix, e.g. /v1)
NEXT_PUBLIC_API_URL=http://localhost:3000/v1

# Google OAuth 2.0 Web Client ID.
# Must also be listed in the server's GOOGLE_ALLOWED_CLIENT_IDS, and this origin
# (e.g. http://localhost:3001) must be in the client's Authorized JavaScript origins.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

# Absolute site URL — used for metadata / OpenGraph tags
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Show the mock sign-in panel (POST /v1/auth/dev-login) on /login.
# Local development only — requires the server's ENABLE_DEV_AUTH=true to succeed.
# NEXT_PUBLIC_* values are inlined at build time; leave unset in production.
NEXT_PUBLIC_ENABLE_DEV_AUTH=false
