# Copy to `.env` and adjust. EXPO_PUBLIC_* values are inlined into the JS bundle
# at build time by Metro — never put secrets here.

# Base URL of the Pluto API (apps/server), including the /v1 prefix.
# - Android emulator: http://10.0.2.2:3000/v1  (10.0.2.2 = host loopback)
# - iOS simulator:    http://localhost:3000/v1
# - Physical device:  http://<your-lan-ip>:3000/v1
EXPO_PUBLIC_API_URL=http://localhost:3000/v1

# Google OAuth client IDs (public identifiers, not secrets).
#
# The *web* client ID is the audience pluto-server verifies, so the same value
# must be listed in apps/server's GOOGLE_ALLOWED_CLIENT_IDS. Required for the
# Android flow, which asks Google for an ID token with this audience.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# The iOS client ID; required only for iOS builds. Its reversed form becomes the
# app's URL scheme, wired up by app.config.ts when this is set.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
