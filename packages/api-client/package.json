{
  "name": "@pluto/api-client",
  "version": "0.1.0",
  "private": true,
  "description": "Generated OpenAPI types and a typed fetch client shared by pluto-web and pluto-mobile.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "generate": "openapi-typescript ../../apps/server/openapi.json -o src/schema.d.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "openapi-typescript": "^7.9.1",
    "typescript": "^5.7.3"
  }
}
