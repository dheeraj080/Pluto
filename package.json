{
  "name": "pluto",
  "private": true,
  "packageManager": "npm@11.16.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "typecheck": "turbo run typecheck",
    "secrets:check": "node scripts/check-secrets.mjs",
    "api:generate": "npm run openapi:generate --workspace pluto-server && npm run generate --workspace @pluto/api-client"
  },
  "devDependencies": {
    "turbo": "^2"
  },
  "overrides": {
    "@types/react": "19.3.0"
  },
  "engines": {
    "node": ">=20.19"
  },
  "allowScripts": {
    "prisma@6.19.3": true,
    "unrs-resolver@1.12.2": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "@swc/core@1.16.13": true
  }
}
